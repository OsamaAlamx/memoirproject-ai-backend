# Supabase Core Configuration (no secrets here - copy to .env locally, set real values in Render dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (Supabase Postgres)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project.supabase.co:5432/postgres

# Authentication & Storage Settings
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
FRONTEND_URL=http://localhost:3000
SUPABASE_BUCKET_NAME=memoir-media
MEDIA_MAX_BYTES=52428800
MEDIA_SIGNED_URL_TTL=300
SHARE_LINK_BASE_URL=http://localhost:3000/live

# LLM (Groq-compatible) - optional locally, required in production for chapters
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Transcription
ASSEMBLYAI_API_KEY=

# CORS - comma-separated. Production: https://<your-app>.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
